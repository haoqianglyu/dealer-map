# 复制为 .env.local（已 gitignore）后填写。不要把真实 Key 提交到仓库。
# 高德开放平台「Web端(JS API)」Key 与安全密钥（JS API 2.0 必填）
# 安全密钥仅开发模式使用；生产构建不打包，由 Worker 的 /_AMapService 代理追加（wrangler secret AMAP_JSCODE）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY=

# 项目拉取：VITE_FETCH_ALL=true 时按 total 翻页取完账号可见的全部项目（渐进显示）；false 时只取第 1 页
VITE_PAGE_SIZE=100
VITE_FETCH_ALL=true

# 共享坐标缓存 FC 触发器 URL（开发代理 /geo-shared 用；生产在 Worker secret GEO_FC_URL）
GEO_FC_URL=
